// Conadis admin · Prisma schema
// Postgres + RBAC (User ↔ Role ↔ Permission) + sessions

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles    UserRole[]
  sessions Session[]

  createdSupporters  Supporter[] @relation("SupporterCreator")
  reviewedSupporters Supporter[] @relation("SupporterReviewer")

  createdPersoneros  Personero[] @relation("PersoneroCreator")
  updatedPersoneros  Personero[] @relation("PersoneroUpdater")

  createdAnnouncements Announcement[] @relation("AnnouncementCreator")
  updatedAnnouncements Announcement[] @relation("AnnouncementUpdater")

  createdContacts       Contact[]       @relation("ContactCreator")
  createdContactImports ContactImport[] @relation("ContactImportCreator")
  createdCampaigns      Campaign[]      @relation("CampaignCreator")

  reviewedActas         ActaElectoral[] @relation("ActaReviewer")

  @@index([active])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  category    String

  roles RolePermission[]

  @@index([category])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id         String      @id @default(cuid())
  userId     String
  token      String      @unique
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  userAgent  String?
  ip         String?
  clientType ClientType  @default(web)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ClientType {
  web
  mobile
}

// ─────────────────────────── Simpatizantes (mapa de apoyos) ───────────────────────────

enum SupporterStatus {
  pending
  approved
  rejected
}

enum SupporterSource {
  admin
  public
}

enum District {
  tambopata
  inambari
  las_piedras
  laberinto
  manu
  fitzcarrald
  madre_de_dios
  huepetuhe
  inapari
  iberia
  tahuamanu
}

enum DocumentType {
  dni
  ce
  passport
}

model Supporter {
  id           String          @id @default(cuid())
  name         String
  phone        String?
  docType      DocumentType    @default(dni)
  docNumber    String?
  latitude     Float?
  longitude    Float?
  gpsAccuracy  Float?
  district     District
  source       SupporterSource
  status       SupporterStatus @default(pending)
  notes        String?
  ip           String?
  createdById  String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  createdBy  User? @relation("SupporterCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("SupporterReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([docType, docNumber])
  @@index([status])
  @@index([district])
  @@index([createdAt])
}

// ─────────────────────── Locales educativos (padrón MINEDU/ESCALE) ───────────────────────
// Colegios de Madre de Dios para autocompletar el local de votación al registrar personeros.

model Local {
  id        String   @id @default(cuid())
  code      String   @unique // CODLOCAL del padrón ESCALE
  name      String
  address   String?
  locality  String?  // centro poblado (ayuda a distinguir colegios rurales homónimos)
  district  District
  latitude  Float?
  longitude Float?
  levels    String?  // niveles que funcionan en el local (Inicial, Primaria, …)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([district])
}

// ─────────────────────────── Personeros (consultor de mesa) ───────────────────────────

enum PersoneroSource {
  admin
  public
}

model Personero {
  id                 String          @id @default(cuid())
  docType            DocumentType    @default(dni)
  docNumber          String
  name               String
  phone              String?         // celular del personero
  source             PersoneroSource @default(admin)
  district           District?
  localName          String          // colegio / local de votación
  localAddress       String?
  mesa               String          // número de mesa (string: permite ceros a la izquierda)
  aula               String?         // aula asignada (ej. "Aula 04 - 1er Piso")
  role               String          @default("titular") // "titular" | "suplente" | "general"
  isSuplente         Boolean         @default(false)
  coordinatorName    String
  coordinatorPhone   String
  active             Boolean         @default(true)
  notes              String?
  whatsappNotifiedAt DateTime?       // fecha y hora de la última notificación enviada
  credentialToken    String?         @unique // token único para acceso público directo a la credencial digital
  isMesaMember       Boolean         @default(false) // si fue designado miembro/suplente de mesa por ONPE
  mesaMemberRole     String?         // cargo de miembro de mesa ONPE si aplica
  experience         Boolean?        // si tiene experiencia previa como personero
  createdById        String?
  updatedById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  createdBy User? @relation("PersoneroCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("PersoneroUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  actas     ActaElectoral[]

  @@unique([docType, docNumber])
  @@index([district])
  @@index([active])
  @@index([mesa])
}

// Locales de votación oficiales ONPE Elecciones Regionales y Municipales 2026
model ElectoralLocal {
  id               String   @id @default(cuid())
  code             String   @unique // correlativo o código de local
  name             String   // nombre oficial del colegio/local (ej. "IEBR FAUSTINO MALDONADO")
  address          String?  // dirección oficial
  district         District
  province         String   // Tambopata, Manu, Tahuamanu
  latitude         Float?
  longitude        Float?
  totalMesas       Int      @default(0)
  coordinatorName  String?  // coordinador asignado al local
  coordinatorPhone String?  // teléfono del coordinador
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mesas ElectoralMesa[]
  actas ActaElectoral[]

  @@index([district])
  @@index([province])
}

// Mesas de sufragio oficiales ONPE (511 mesas en Madre de Dios)
model ElectoralMesa {
  id             String   @id @default(cuid())
  number         String   @unique // número oficial de mesa de 6 dígitos
  localId        String
  aula           String?  // aula o pabellón
  onpePresidente String?  // nombre del Presidente de Mesa ONPE
  onpeSecretario String?  // nombre del Secretario de Mesa ONPE
  onpeSuplentes  String?  // suplentes ONPE
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  local ElectoralLocal @relation(fields: [localId], references: [id], onDelete: Cascade)

  @@index([localId])
}

// Ajustes globales clave/valor (p. ej. si la inscripción pública de personeros está abierta).
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Avisos de campaña que se muestran en un modal en la página principal.
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  imagePath   String?   // nombre de archivo dentro de UPLOADS_DIR/anuncios
  ctaLabel    String?
  ctaUrl      String?
  published   Boolean   @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User? @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("AnnouncementUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([published, startsAt, endsAt])
}

// ─────────────────────────── Mensajería (contactos + campañas WhatsApp) ───────────────────────────

enum WhatsappStatus {
  unknown
  yes
  no
}

enum MessageChannel {
  whatsapp
}

enum CampaignStatus {
  draft
  running
  paused
  finished
  cancelled
}

enum CampaignAudience {
  all // todos los contactos activos (sin baja y con WhatsApp ≠ no)
  not_contacted // contactos sin lastMessagedAt
  district // contactos de un distrito (campaign.district)
}

enum RecipientStatus {
  pending
  sent // aceptado por WAHA (ack SERVER pendiente)
  delivered // ack DEVICE
  read // ack READ / PLAYED
  failed // error de envío tras reintentos, o ack ERROR
  no_whatsapp // check-exists = false
  opted_out // el contacto pidió baja antes del envío
  skipped // campaña cancelada con el destinatario aún pendiente
}

model Contact {
  id             String         @id @default(cuid())
  docType        DocumentType   @default(dni)
  docNumber      String? // opcional: la clave del contacto es el celular
  name           String         @default("") // opcional
  phone          String         @unique // E.164: +519XXXXXXXX — clave única del contacto
  district       District?
  source         String // origen de la lista (texto de la importación)
  whatsappStatus WhatsappStatus @default(unknown)
  checkedAt      DateTime? // último check-exists
  optedOut       Boolean        @default(false)
  optedOutAt     DateTime?
  optedOutReason String? // "reply:<texto>" | "manual:<userId>"
  lastMessagedAt DateTime?
  importId       String? // última importación que lo creó/actualizó
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  import     ContactImport?      @relation(fields: [importId], references: [id], onDelete: SetNull)
  createdBy  User?               @relation("ContactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@unique([docType, docNumber])
  @@index([optedOut])
  @@index([whatsappStatus])
  @@index([district])
}

model ContactImport {
  id               String   @id @default(cuid())
  fileName         String
  source           String // "Padrón de personeros 2026", "Inscritos feria Puerto Maldonado"…
  consentConfirmed Boolean // checkbox obligatorio en la UI
  totalRows        Int
  inserted         Int      @default(0)
  updated          Int      @default(0)
  invalid          Int // celular inválido (no se importan)
  duplicatedInFile Int // celulares repetidos dentro del archivo (se conserva la última fila)
  finishedAt       DateTime?
  createdById      String?
  createdAt        DateTime @default(now())

  createdBy User?     @relation("ContactImportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contacts  Contact[]
}

model WhatsappSession {
  id        String   @id @default(cuid())
  name      String   @unique // nombre de la sesión en WAHA (a-zA-Z0-9-_)
  label     String // nombre visible: "Número principal", "Número Tambopata"…
  phone     String? // +51XXXXXXXXX; se rellena solo al vincular (me.id de WAHA)
  active    Boolean  @default(true) // desactivada = el motor la ignora
  dailyCap  Int      @default(500) // tope diario propio de este número
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignSessions CampaignSession[]
  counters         MessagingDailyCounter[]

  @@index([active])
}

model Campaign {
  id              String           @id @default(cuid())
  name            String
  channel         MessageChannel   @default(whatsapp)
  messageTemplate String // admite {nombre} y {dni}
  audience        CampaignAudience
  district        District? // solo si audience = district
  status          CampaignStatus   @default(draft)
  dailyCap        Int              @default(150)
  minDelaySec     Int              @default(45)
  maxDelaySec     Int              @default(120)
  windowStart     Int              @default(8) // hora Lima (0-23) inclusive
  windowEnd       Int              @default(20) // hora Lima exclusiva
  totalRecipients Int              @default(0)
  sentCount       Int              @default(0) // sent+delivered+read
  failedCount     Int              @default(0) // failed+no_whatsapp
  lastError       String?
  pausedReason    String? // "session_down" | "manual" | "waha_error" | "veda"
  // Rotación entre los números del pool: cada `rotationBatch` envíos pasa el turno al siguiente.
  // 0 = sin turnos, todos los números envían a la vez (cada uno a su ritmo).
  rotationBatch   Int              @default(20)
  cursorSessionId String? // número al que le toca enviar (null = el primero del pool)
  cursorSent      Int              @default(0) // envíos del turno en curso
  startedAt       DateTime?
  finishedAt      DateTime?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy  User?               @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sessions   CampaignSession[] // números desde los que sale (pool)
  recipients CampaignRecipient[]

  @@index([status])
}

/** Un número dentro del pool de una campaña, con lo que lleva enviado. */
model CampaignSession {
  campaignId String
  sessionId  String
  position   Int // orden de turno dentro del pool
  sentCount  Int @default(0)

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  session  WhatsappSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@id([campaignId, sessionId])
  @@index([sessionId])
}

model CampaignRecipient {
  id            String          @id @default(cuid())
  campaignId    String
  contactId     String
  status        RecipientStatus @default(pending)
  attempts      Int             @default(0)
  wahaMessageId String?
  error         String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  updatedAt     DateTime        @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@unique([wahaMessageId])
  @@index([campaignId, status])
}

model MessagingDailyCounter {
  day       String // "YYYY-MM-DD" en hora Lima
  sessionId String
  count     Int    @default(0)

  session WhatsappSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([day, sessionId])
}

// ─────────────────────────── Control y Monitoreo Electoral ───────────────────────────

enum CandidateCargo {
  gobernador
  provincial
  distrital
}

model Candidate {
  id         String         @id @default(cuid())
  name       String         // Nombre completo del candidato (ej. SIMON PEDRO HORNA ALPACA)
  party      String         // Partido político (ej. AHORA NACION - AN)
  partyLogo  String?        // URL del logo del partido
  photoUrl   String?        // URL de la foto oficial del candidato
  cargo      CandidateCargo @default(gobernador)
  order      Int            @default(1) // Orden en la cédula / acta de escrutinio
  color      String         @default("#dc2626") // Color hexadecimal para gráficos
  province   String?        // Tambopata, Manu, Tahuamanu
  district   District?
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  actaVotos  ActaVoto[]

  @@index([cargo, active])
  @@index([order])
}

enum ActaStatus {
  draft
  enviada
  en_revision
  aprobada
  observada
  anulada
}

model ActaElectoral {
  id                String       @id @default(cuid())
  mesaNumber        String       // Número oficial de mesa de 6 dígitos
  localId           String       // Local de votación donde está la mesa
  personeroId       String?      // Personero que subió el acta
  photoUrl          String       // URL o base64 de la fotografía del acta de escrutinio
  status            ActaStatus   @default(enviada)
  source            String       @default("manual") // "manual" | "ia"
  electionType      String       @default("gobernador") // "gobernador" | "provincial"
  observationReason String?      // Motivo en caso de ser observada por el verificador
  reviewedById      String?      // Operador / verificador que revisó
  reviewedAt        DateTime?
  votosBlancos      Int          @default(0)
  votosNulos        Int          @default(0)
  votosImpugnados   Int          @default(0)
  totalVotos        Int          @default(0)
  submittedAt       DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  local      ElectoralLocal @relation(fields: [localId], references: [id], onDelete: Cascade)
  personero  Personero?     @relation(fields: [personeroId], references: [id], onDelete: SetNull)
  reviewedBy User?          @relation("ActaReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  votos      ActaVoto[]

  @@unique([mesaNumber, electionType])
  @@index([status])
  @@index([electionType])
  @@index([localId])
}

model ActaVoto {
  id          String        @id @default(cuid())
  actaId      String
  candidateId String
  votes       Int           @default(0)

  acta      ActaElectoral @relation(fields: [actaId], references: [id], onDelete: Cascade)
  candidate Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([actaId, candidateId])
  @@index([candidateId])
}

